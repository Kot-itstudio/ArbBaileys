{
  "name": "baileys-ts-fork",
  "version": "1.0.0",
  "description": "A TypeScript fork of Baileys (WhatsApp Web multi-device) with extended message features: buttons, lists, carousels and rich replies.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.ts\"",
    "example": "node examples/basic.js"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "multi-device",
    "buttons",
    "lists",
    "carousel"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.8",
    "futoin-hkdf": "^1.5.3",
    "libsignal": "github:WhiskeySockets/libsignal-node",
    "lodash": "^4.17.21",
    "pino": "^7.11.0",
    "protobufjs": "^7.2.6",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.11.30",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.5"
  }
}
